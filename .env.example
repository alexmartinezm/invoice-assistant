# Copy to .env and fill in. Every variable below is read by the Api at startup, and a real
# environment variable always wins over this file — so the same names work with `dotnet run`, with
# Docker Compose and in a hosting panel.

# --- Database --------------------------------------------------------------
# PostgreSQL (ADR 006). Either an Npgsql keyword string or the postgres:// URL that hosting panels
# hand out. `docker compose up -d postgres` serves the default below.
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=invoice_assistant;Username=postgres;Password=postgres

# Credentials for the Compose database, if you change them from the defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=invoice_assistant

# --- Invoicing -------------------------------------------------------------
# Money and dates in one place: the API responses, the seed ledger, the assistant's formatting
# instruction and the SPA's number formatting all read these. Defaults are in appsettings.json;
# set any of them here to run the demo for another market.
#
# INVOICING_CURRENCY=USD                  # ISO 4217, carried on every list and report response
# INVOICING_CURRENCY_SYMBOL=$             # only used in the assistant's formatting example
# INVOICING_LOCALE=en-US                  # BCP 47; decides 1,240.50 vs 1.240,50 and the date order
# INVOICING_TAX_LABEL=Sales tax           # what the tax line is called on the invoice detail
# INVOICING_MARKET=en-US                  # whose seeded customers and staff: es-ES, en-US, en-GB, de-DE.
#                                         # Independent of the locale — a London controller may be
#                                         # reading a Spanish subsidiary's ledger.
# INVOICING_DEFAULT_VAT_RATE=0.20         # a fraction, not a percentage
# INVOICING_REDUCED_VAT_RATE=0.05
# INVOICING_PAYMENT_TERM_DAYS=30
# INVOICING_ACCOUNTANT_MARK_PAID_LIMIT=1000

# --- AI provider -----------------------------------------------------------
# azure-openai | openai-compatible
# Leave the credentials blank and the app still runs: only /api/chat answers 503.
AI_PROVIDER=azure-openai

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# OpenAI-compatible endpoint (fallback). OPENAI_BASE_URL is optional; CHAT_MODEL is not.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Models: a higher-quality one for the demo chat, a cheap one for evals.
CHAT_MODEL=
EVALS_MODEL=

# Token cap for one whole evals run (input + output); the run fails if it is exceeded.
# EVALS_RUN_TOKEN_BUDGET=250000

# --- Cost ------------------------------------------------------------------
# Spend kill switch: global daily cap in euros. Once reached, /api/chat returns 429.
# Enforced from F4.
USAGE_DAILY_BUDGET_EUR=1

# --- App -------------------------------------------------------------------
# Must be long enough for HMAC-SHA256.
JWT_SIGNING_KEY=change-me-demo-only-must-be-at-least-32-characters
ASPNETCORE_ENVIRONMENT=Development

# --- Telemetry (optional) --------------------------------------------------
# Traces go to the console in Development. Point this at a collector to export OTLP as well.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORTER=
