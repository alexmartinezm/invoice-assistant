# --- AI provider -----------------------------------------------------------
# Azure OpenAI by default; alternatively any OpenAI-compatible endpoint.
AI_PROVIDER=azure-openai            # azure-openai | openai-compatible

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# OpenAI-compatible endpoint (fallback)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Models: a higher-quality one for the demo chat, a cheap one for evals.
CHAT_MODEL=
EVALS_MODEL=

# --- Cost ------------------------------------------------------------------
# Spend kill switch: global daily cap in euros. Once reached, /api/chat
# returns 429.
USAGE_DAILY_BUDGET_EUR=1

# --- App -------------------------------------------------------------------
JWT_SIGNING_KEY=change-me-demo-only
ASPNETCORE_ENVIRONMENT=Development
