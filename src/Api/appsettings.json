{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=invoice_assistant;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "invoice-assistant",
    "Audience": "invoice-assistant",
    "LifetimeMinutes": 60
  },
  "Invoicing": {
    "Currency": "EUR",
    "CurrencySymbol": "€",
    "Locale": "en-GB",
    "Market": "es-ES",
    "TaxLabel": "VAT",
    "DefaultVatRate": 0.21,
    "ReducedVatRate": 0.10,
    "DefaultPaymentTermDays": 30,
    "AccountantMarkPaidLimit": 1000,
    "DefaultPageSize": 50,
    "MaxPageSize": 100
  },
  "Assistant": {
    "HistoryMessages": 20,
    "MaxInputCharacters": 2000,
    "MaxOutputTokens": 800,
    "MaxToolCallsPerTurn": 8,
    "TurnsPerMinute": 20
  },
  "AI": {
    "Provider": "azure-openai"
  },
  "Usage": {
    "DailyBudgetEur": 1,
    "Prices": [
      { "Model": "gpt-4o", "InputPer1MEur": 2.3, "OutputPer1MEur": 9.2 },
      { "Model": "gpt-4o-mini", "InputPer1MEur": 0.14, "OutputPer1MEur": 0.55 },
      { "Model": "gpt-4.1", "InputPer1MEur": 1.85, "OutputPer1MEur": 7.4 },
      { "Model": "gpt-4.1-mini", "InputPer1MEur": 0.37, "OutputPer1MEur": 1.48 },
      { "Model": "gpt-4.1-nano", "InputPer1MEur": 0.09, "OutputPer1MEur": 0.37 },
      { "Model": "gpt-5", "InputPer1MEur": 1.15, "OutputPer1MEur": 9.2 },
      { "Model": "gpt-5-mini", "InputPer1MEur": 0.23, "OutputPer1MEur": 1.85 },
      { "Model": "gpt-5-nano", "InputPer1MEur": 0.05, "OutputPer1MEur": 0.37 }
    ]
  }
}
